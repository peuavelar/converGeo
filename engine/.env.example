# Motor ConverGeo (FastAPI + ETL)
# Não versionar dados brutos da Receita/IBGE.

DATABASE_URL=
# Schema PostgreSQL
DB_SCHEMA=convergeo

# Origens CORS (vírgula). Vazio = localhost Next.
ALLOWED_ORIGINS=http://localhost:3000,https://convergeo-front.vercel.app

# Grade H3
H3_RESOLUTION=8
MIN_LAND_AREA_FRAC=0.15

# IBGE — códigos oficiais (https://www.ibge.gov.br/explica/codigos-dos-municipios.php)
IBGE_SALVADOR=2927408
IBGE_LAURO=2919207

# Caminhos de dados oficiais (CLI/env). Nunca caminhos de usuário hardcoded.
IBGE_MALHA_PATH=
IBGE_SETORES_PATH=
IBGE_RENDA_PATH=
RF_CNPJ_DIR=
RF_MUNICIPIOS_CSV=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim (política: 1 req/s, User-Agent identificado)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ConverGeo/1.3 (https://github.com/peuavelar/converGeo)
NOMINATIM_MIN_INTERVAL_S=1.0

# Peso de empresas geocodificadas só no centróide do bairro
BAIRRO_GEO_WEIGHT=0.4

# Marketplace
MIN_BUCKET_N=8
FAIR_PRICE_BELOW_PCT=-0.08
FAIR_PRICE_ABOVE_PCT=0.08
ENABLE_HEDONIC=false

# Auth MVP (hash SHA-256 da API key)
ENGINE_ADMIN_KEY=

# LLM explicativo (Fase 6). Vazio = só template.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=8
