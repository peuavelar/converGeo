# ConverGeo Web — variáveis de ambiente
# Copie para .env.local (não versionado)

# Fonte de dados geo: osm | backend | hybrid
DATA_PROVIDER=osm

# Motor Python / FastAPI (quando DATA_PROVIDER=backend|hybrid)
BACKEND_ORIGIN=http://127.0.0.1:8000
# Alternativa usada também pelo rewrite /backend/*
# NEXT_PUBLIC_API_URL=https://convergeo.onrender.com

# Identificação exigida pelo Nominatim OSM
OSM_USER_AGENT=ConverGeo/1.1 (https://github.com/peuavelar/converGeo)

# Raio padrão de POIs (metros)
OSM_NEARBY_RADIUS_M=1500

# Cache do BFF nearby (ms)
OSM_NEARBY_CACHE_TTL_MS=300000
