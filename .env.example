# ConverGeo Web — variáveis de ambiente
# Copie para .env.local (não versionado)

# Fonte de dados geo: osm | backend | hybrid
DATA_PROVIDER=osm

OSM_USER_AGENT=ConverGeo/1.3 (https://github.com/peuavelar/converGeo)

# Motor FastAPI local (engine/) — rewrite /backend
BACKEND_ORIGIN=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=https://convergeo.onrender.com

# Marketplace: mock (padrão) | api (consome /backend/v2)
NEXT_PUBLIC_MARKETPLACE_SOURCE=mock

# Raio padrão de POIs (metros)
OSM_NEARBY_RADIUS_M=1500

# Cache do BFF nearby (ms)
OSM_NEARBY_CACHE_TTL_MS=300000

# Benchmarks externos → Opportunity Score calibrado (A+S1)
# off por padrão — ligue para comparar before/after
ENABLE_EXTERNAL_BENCHMARK=false
NEXT_PUBLIC_ENABLE_EXTERNAL_BENCHMARK=false
CRON_SECRET=
# BENCHMARK_STORE_DIR=./data/benchmarks
